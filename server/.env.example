# Copy this file to `.env` and fill in the real values.

# PostgreSQL connection string used by Prisma.
# Example for a local PostgreSQL install:
#   postgresql://blogspace:your_password@localhost:5432/blogspace?schema=public
DATABASE_URL=

# Secret used to sign JWTs. Use a long random string.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the Express server listens on.
PORT=5000

# Origin of the React frontend, used for CORS.
CLIENT_ORIGIN=http://localhost:5173