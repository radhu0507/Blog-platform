# Copy this file to `.env` and fill in the real values.

# PostgreSQL connection string used by Prisma AT RUNTIME.
#
# On a managed database this should be the POOLED connection string (Neon,
# Supabase, or anything fronted by PgBouncer). A pooler caps how many database
# connections can exist at once, which is what stops an autoscaled or
# serverless deployment from exhausting PostgreSQL's connection limit.
#   postgresql://blogspace:your_password@localhost:5432/blogspace?schema=public
#   postgresql://USER:PASSWORD@HOST/DB?sslmode=require            (pooled)
#
# MIGRATIONS need the DIRECT (unpooled) connection string instead. Transaction
# poolers such as PgBouncer do not support the session-level state that
# `prisma migrate` depends on, so running migrations through the pooled URL
# fails or corrupts schema history. Keep the direct URL handy for migrate steps:
#   postgresql://USER:PASSWORD@HOST/DB?sslmode=require&directConnection=true
#
# In the Neon dashboard both appear under "Connection string": use the one
# labelled *pooled* for DATABASE_URL, and the one labelled *direct* when running
# migrations against a fresh database.
DATABASE_URL=

# Secret used to sign JWTs. Use a long random string.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# On a hosted platform let the host generate this for you (Render's
# `generateValue: true`) rather than committing a value here.
JWT_SECRET=

# Port the Express server listens on. Render, Railway and Fly all inject this,
# so leave it unset in production and only set it for local runs.
PORT=5000

# Origin of the browser frontend, used for CORS.
#
# In the single-service deployment the React app is served by this same Express
# process, so every request is same-origin and CORS is not involved. Set this
# only when the frontend is hosted separately (for example the Vite dev server,
# or a split Vercel + API setup).
CORS_ORIGIN=http://localhost:5173

# Deprecated alias for CORS_ORIGIN. Still read for backwards compatibility with
# older .env files; prefer CORS_ORIGIN.
# CLIENT_ORIGIN=http://localhost:5173

# development | test | production. Setting this to "production" is what enables
# Express to serve the built React app from client/dist.
NODE_ENV=development