// BlogSpace database schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String // bcrypt hash - never a plain-text password
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  posts    Post[]
  comments Comment[]
}

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A post belongs to one user. Deleting the user deletes their posts.
  authorId String
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Deleting a post also deletes its comments.
  comments Comment[]

  @@index([authorId])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A comment belongs to one user.
  authorId String
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // A comment belongs to one post. Deleting the post deletes its comments.
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([postId])
}